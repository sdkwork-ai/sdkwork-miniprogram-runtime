{
  "$schema": "https://sdkwork.com/schemas/agent-workflow.schema.json",
  "schemaVersion": "2026-06-06.agent.workflow.v1",
  "workflowRole": "ci-only",
  "app": {
    "id": "sdkwork-miniprogram-runtime",
    "name": "SDKWORK Mini Program Runtime",
    "repository": "sdkwork-ai/sdkwork-miniprogram-runtime",
    "sourcePath": "."
  },
  "release": {
    "artifactPrefix": "sdkwork-miniprogram-runtime",
    "defaultVersion": "0.1.0"
  },
  "toolchains": {
    "node": "24",
    "pnpm": "10.33.0",
    "rust": "stable"
  },
  "ci": {
    "setup": [
      {
        "name": "Install pinned Cargo security audit tools",
        "run": "cargo install cargo-audit --version 0.22.1 --locked && cargo install cargo-deny --version 0.18.3 --locked"
      }
    ]
  },
  "targets": []
}
